        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Race 2] POST /api/v1/clients (mismo email)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{
  &quot;name&quot;: &quot;JMeter Race Client ${__threadNum}&quot;,
  &quot;email&quot;: &quot;${__P(sg.sharedEmail)}&quot;,
  &quot;phone&quot;: &quot;+56987654321&quot;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/clients</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 201 o 409 (sin 500)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="123456789">^(201|409)$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Solo se permiten respuestas 201 Created o 409 Conflict</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Contabilizar 201/409 y validar código CLIENTS_BS002" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String status = prev.getResponseCode()
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (status == "201") {
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.cli.201", "0")) + 1
        props.setProperty("sg.cli.201", String.valueOf(c))
    }
} else if (status == "409") {
    if (json.code != "CLIENTS_BS002") {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Se esperaba CLIENTS_BS002 en 409, pero llegó: " + json.code)
        return
    }
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.cli.409", "0")) + 1
        props.setProperty("sg.cli.409", String.valueOf(c))
    }
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Estado HTTP inesperado en carrera de clientes: " + status)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- =================================================================== -->
      <!-- Escenario 3: 20 cancelaciones simultáneas sobre la misma reserva    -->
      <!-- =================================================================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="3. Cancelación Simultánea — PATCH /cancel (Misma Reserva)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Barrera Sincronizada (${THREADS} hilos)" enabled="true">
          <stringProp name="groupSize">${THREADS}</stringProp>
          <longProp name="timeoutInMs">10000</longProp>
        </SyncTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Race 3] PATCH /api/v1/reservations/{id}/cancel" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/reservations/${__P(sg.cancelReservationId)}/cancel</stringProp>
          <stringProp name="HTTPSampler.method">PATCH</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200 o 409 (sin 500)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="123456790">^(200|409)$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Solo se permiten respuestas 200 OK o 409 Conflict</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Contabilizar 200/409 y validar código RESERVATIONS_BS010" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String status = prev.getResponseCode()
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (status == "200") {
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.can.200", "0")) + 1
        props.setProperty("sg.can.200", String.valueOf(c))
    }
} else if (status == "409") {
    if (json.code != "RESERVATIONS_BS010") {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Se esperaba RESERVATIONS_BS010 en 409, pero llegó: " + json.code)
        return
    }
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.can.409", "0")) + 1
        props.setProperty("sg.can.409", String.valueOf(c))
    }
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Estado HTTP inesperado en carrera de cancelaciones: " + status)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- =================================================================== -->
      <!-- tearDown Thread Group: verifica invariantes exactos en data.json    -->
      <!-- =================================================================== -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown — Verificar Integridad y Contadores Exactos" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </PostThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Verify] 1. Confirmar exactamente 1 reserva persistida y conteos exactos" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/reservations?date=${BOOKING_DATE}&amp;tableId=${__P(sg.tableId)}&amp;status=PENDING</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Consulta de verificación debe responder HTTP 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar 1 éxito y (N-1) conflictos en los 3 escenarios" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

int threads = Integer.parseInt(vars.get("THREADS"))
int expectedConflicts = threads - 1

def reservations = new JsonSlurper().parseText(prev.getResponseDataAsString())
int res201 = Integer.parseInt(props.getProperty("sg.res.201", "0"))
int res409 = Integer.parseInt(props.getProperty("sg.res.409", "0"))
int cli201 = Integer.parseInt(props.getProperty("sg.cli.201", "0"))
int cli409 = Integer.parseInt(props.getProperty("sg.cli.409", "0"))
int can200 = Integer.parseInt(props.getProperty("sg.can.200", "0"))
int can409 = Integer.parseInt(props.getProperty("sg.can.409", "0"))

List&lt;String&gt; errors = []
if (reservations.size() != 1) {
    errors.add("Se esperaba exactamente 1 reserva PENDING persistida, pero hay " + reservations.size())
}
if (res201 != 1 || res409 != expectedConflicts) {
    errors.add("Reservas concurrentes: esperado 1x201 y " + expectedConflicts + "x409, obtenido " + res201 + "x201 y " + res409 + "x409")
}
if (cli201 != 1 || cli409 != expectedConflicts) {
    errors.add("Clientes concurrentes: esperado 1x201 y " + expectedConflicts + "x409, obtenido " + cli201 + "x201 y " + cli409 + "x409")
}
if (can200 != 1 || can409 != expectedConflicts) {
    errors.add("Cancelaciones concurrentes: esperado 1x200 y " + expectedConflicts + "x409, obtenido " + can200 + "x200 y " + can409 + "x409")
}

if (!errors.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(errors.join(" | "))
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Verify] 2. Confirmar liberación inmediata de disponibilidad tras cancelación" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/tables/availability?date=${BOOKING_DATE}&amp;time=${CANCEL_TIME}&amp;guests=4</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Consulta de disponibilidad debe responder HTTP 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validar que la mesa cancelada volvió a estar disponible" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

long targetTableId = Long.parseLong(props.getProperty("sg.tableId"))
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
boolean found = json.availableTables.any { it.id == targetTableId }

if (!found) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("La mesa " + targetTableId + " no apareció disponible tras la cancelación concurrente")
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>

