      <!-- =================================================================== -->
      <!-- Escenario 1 (SG-PER-04): 20 reservas simultáneas misma mesa y turno -->
      <!-- =================================================================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1. SG-PER-04 — Reservas Simultáneas (Misma Mesa y Turno)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Barrera Sincronizada (${THREADS} hilos)" enabled="true">
          <stringProp name="groupSize">${THREADS}</stringProp>
          <longProp name="timeoutInMs">10000</longProp>
        </SyncTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Race 1] POST /api/v1/reservations (misma mesa/turno)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{
  &quot;clientId&quot;: ${__P(sg.clientId)},
  &quot;tableId&quot;: ${__P(sg.tableId)},
  &quot;date&quot;: &quot;${BOOKING_DATE}&quot;,
  &quot;startTime&quot;: &quot;${BOOKING_TIME}&quot;,
  &quot;guestCount&quot;: 4,
  &quot;notes&quot;: &quot;JMeter thread ${__threadNum}&quot;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/reservations</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 201 o 409 (sin 500)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="123456789">^(201|409)$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Solo se permiten respuestas 201 Created o 409 Conflict</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Contabilizar 201/409 y validar código RESERVATIONS_BS006" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String status = prev.getResponseCode()
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())

if (status == "201") {
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.res.201", "0")) + 1
        props.setProperty("sg.res.201", String.valueOf(c))
    }
} else if (status == "409") {
    if (json.code != "RESERVATIONS_BS006") {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("Se esperaba RESERVATIONS_BS006 en 409, pero llegó: " + json.code)
        return
    }
    synchronized (props) {
        int c = Integer.parseInt(props.getProperty("sg.res.409", "0")) + 1
        props.setProperty("sg.res.409", String.valueOf(c))
    }
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Estado HTTP inesperado en carrera de reservas: " + status)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- =================================================================== -->
      <!-- Escenario 2: 20 registros simultáneos con el mismo email            -->
      <!-- =================================================================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="2. Unicidad de Email — Registros Simultáneos (POST /clients)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
